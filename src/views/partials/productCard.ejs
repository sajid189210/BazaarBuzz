<% const showDiscount = product.discount && product.discount > 0; const hasOffer = typeof offer !== 'undefined' && offer && offer.discount > 0; %>
<div class="group product-card border border-[var(--card-border)] bg-white rounded-xl overflow-hidden transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[var(--card-border-hover)] hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-2">
  <a href="/user/viewProduct?productId=<%= product._id %>" class="block btn-press">
    <div class="relative overflow-hidden bg-gray-50 aspect-square">
      <img src="<%= product.images?.[0] || '/uploads/placeholder.jpg' %>" alt="<%= product.productName %>"
        class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-out"
        loading="lazy" />

      <% if (product.discount && product.discount > 0) { %>
        <div class="absolute top-2 left-2 z-10">
          <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-[var(--badge-sale)] text-[var(--badge-sale-text)]">
            -<%= product.discount %>%
          </span>
        </div>
      <% } %>

      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-300"></div>
    </div>

    <div class="p-3 space-y-1.5">
      <p class="text-[10px] text-[var(--text-brand)] uppercase tracking-widest font-medium truncate">
        <%= product.brand || 'BazaarBuzz' %>
      </p>

      <h3 class="text-xs font-medium text-[var(--text-primary)] line-clamp-2 min-h-[2rem] leading-snug">
        <%= product.productName %>
      </h3>

      <div class="flex items-center gap-1.5 flex-wrap min-h-[1.25rem]">
        <% if (hasOffer) { %>
          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-semibold bg-green-600 text-white">
            <%= offer.offerName %>
          </span>
        <% } %>
        <% if (showDiscount) { %>
          <span class="text-[9px] font-semibold text-[var(--badge-sale)]">
            -<%= product.discount %>% off
          </span>
        <% } %>
      </div>

      <div class="flex items-baseline gap-1.5">
        <% if (hasOffer) { %>
          <span class="text-sm font-bold text-[var(--text-primary)]">₹<%= finalPrice.toLocaleString('en-IN') %></span>
          <span class="text-[11px] text-[var(--text-muted)] line-through">₹<%= product.productPrice.toLocaleString('en-IN') %></span>
        <% } else if (showDiscount) { %>
          <span class="text-sm font-bold text-[var(--text-primary)]">₹<%= discPrice.toLocaleString('en-IN') %></span>
          <span class="text-[11px] text-[var(--text-muted)] line-through">₹<%= product.productPrice.toLocaleString('en-IN') %></span>
        <% } else { %>
          <span class="text-sm font-bold text-[var(--text-primary)]">₹<%= product.productPrice.toLocaleString('en-IN') %></span>
        <% } %>
      </div>
    </div>
  </a>
</div>
