<% const showDiscount = product.discount && product.discount > 0; const hasOffer = typeof offer !== 'undefined' && offer && offer.discount > 0; %>
<div class="group product-card border border-[var(--card-border)] bg-white rounded-lg overflow-hidden transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-[var(--card-border-hover)] hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-2">
  <a href="/user/viewProduct?productId=<%= product._id %>" class="block btn-press">
    <div class="relative overflow-hidden bg-gray-50 aspect-square">
      <img src="<%= product.images?.[0] || '/uploads/placeholder.jpg' %>" alt="<%= product.productName %>"
        class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-700 ease-out"
        loading="lazy" />

      <% if (product.discount && product.discount > 0) { %>
        <div class="absolute top-1.5 left-1.5 z-10">
          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-[var(--badge-sale)] text-[var(--badge-sale-text)]">
            -<%= product.discount %>%
          </span>
        </div>
      <% } %>

      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-300"></div>
    </div>

    <div class="p-2 space-y-1">
      <p class="text-[9px] text-[var(--text-brand)] uppercase tracking-widest font-medium truncate">
        <%= product.brand || 'BazaarBuzz' %>
      </p>

      <h3 class="text-[11px] font-medium text-[var(--text-primary)] line-clamp-2 min-h-[1.65rem] leading-tight">
        <%= product.productName %>
      </h3>

      <div class="flex items-center gap-1 flex-wrap min-h-[1rem]">
        <% if (product.limitedEdition) { %>
          <span class="inline-flex items-center px-1 py-0.5 rounded text-[8px] font-semibold bg-amber-600 text-white leading-none">
            Limited
          </span>
        <% } %>
        <% if (product.featured) { %>
          <span class="inline-flex items-center px-1 py-0.5 rounded text-[8px] font-semibold bg-[var(--accent)] text-white leading-none">
            Featured
          </span>
        <% } %>
        <% if (hasOffer) { %>
          <span class="inline-flex items-center px-1 py-0.5 rounded text-[8px] font-semibold bg-green-600 text-white leading-none">
            <%= offer.offerName %>
          </span>
        <% } %>
        <% if (showDiscount) { %>
          <span class="text-[8px] font-semibold text-[var(--badge-sale)] leading-none">
            -<%= product.discount %>% off
          </span>
        <% } %>
      </div>

      <div class="flex items-baseline gap-1">
        <% if (hasOffer) { %>
          <span class="text-xs font-bold text-[var(--text-primary)]">&#8377;<%= finalPrice.toLocaleString('en-IN') %></span>
          <span class="text-[10px] text-[var(--text-muted)] line-through">&#8377;<%= product.productPrice.toLocaleString('en-IN') %></span>
        <% } else if (showDiscount) { %>
          <span class="text-xs font-bold text-[var(--text-primary)]">&#8377;<%= discPrice.toLocaleString('en-IN') %></span>
          <span class="text-[10px] text-[var(--text-muted)] line-through">&#8377;<%= product.productPrice.toLocaleString('en-IN') %></span>
        <% } else { %>
          <span class="text-xs font-bold text-[var(--text-primary)]">&#8377;<%= product.productPrice.toLocaleString('en-IN') %></span>
        <% } %>
      </div>
    </div>
  </a>
</div>
