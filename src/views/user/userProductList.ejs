<% blocks.head=`<script src="/javascript/user/reveal.js"></script>` %>
    <div class="mx-auto max-w-[1400px] px-3 xs:px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-12"> <!-- Breadcrumbs -->
        <nav class="hidden lg:flex items-center gap-2 text-sm text-gray-500 mb-6"> <a href="/"
                class="hover:text-[var(--accent)] transition-colors btn-press">Home</a> <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i> <span class="text-gray-800 font-medium">Products</span> </nav>
        <div class="flex gap-8"> <!-- Sidebar Filters -->
            <aside id="dropdown-menu" class="hidden md:block w-64 shrink-0">
                <form method="GET" action="/user/filterProductList/<%= collectionId %>">
                <div class="sticky top-24 space-y-6">
                    <div class="flex items-center justify-between">
                        <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider">Filters</h3>
                        <a href="/user/getProductList/<%= collectionId %>"
                            class="text-xs text-[var(--accent)] hover:text-[var(--accent)] font-medium transition-colors btn-press">Clear
                            All</a>
                    </div>
                    <div>
                        <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Categories</h4>
                        <div class="space-y-2">
                            <% if(categories && categories.length> 0) { %>
                                <% var selectedCats = typeof categoryFilter === 'string' ? [categoryFilter] : (Array.isArray(categoryFilter) ? categoryFilter : []); %>
                                <% categories.forEach(category=> { %> <label
                                        class="flex items-center gap-2 cursor-pointer group"> <input type="checkbox"
                                            name="categoryFilter" value="<%=category.title%>"
                                            <%= selectedCats.indexOf(category.title) !== -1 ? 'checked' : '' %>
                                            class="w-4 h-4 text-[var(--accent)] border-gray-300 focus:ring-rose-400">
                                        <span class="text-sm text-gray-600 group-hover:text-gray-900 transition-colors">
                                            <%= category.title %>
                                        </span> </label>
                                    <% }) %>
                                        <% } else { %>
                                            <p class="text-sm text-gray-400">No categories</p>
                                            <% } %>
                        </div>
                    </div>
                    <hr class="border-gray-100">
                    <div>
                        <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Sort by</h4>
                        <div class="space-y-2">
                            <label class="flex items-center gap-2 cursor-pointer group"> <input
                                    type="radio" name="sort" value="price_high"
                                    <%= sort === 'price_high' ? 'checked' : '' %>
                                    class="w-4 h-4 text-[var(--accent)] border-gray-300 focus:ring-rose-400"> <span
                                    class="text-sm text-gray-600 group-hover:text-gray-900 transition-colors">Price: High to
                                    Low</span> </label>
                            <label class="flex items-center gap-2 cursor-pointer group"> <input
                                    type="radio" name="sort" value="price_low"
                                    <%= sort === 'price_low' ? 'checked' : '' %>
                                    class="w-4 h-4 text-[var(--accent)] border-gray-300 focus:ring-rose-400"> <span
                                    class="text-sm text-gray-600 group-hover:text-gray-900 transition-colors">Price: Low to
                                    High</span> </label>
                            <label class="flex items-center gap-2 cursor-pointer group"> <input
                                    type="radio" name="sort" value="name_asc"
                                    <%= sort === 'name_asc' ? 'checked' : '' %>
                                    class="w-4 h-4 text-[var(--accent)] border-gray-300 focus:ring-rose-400"> <span
                                    class="text-sm text-gray-600 group-hover:text-gray-900 transition-colors">Name: A-Z</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer group"> <input
                                    type="radio" name="sort" value="name_desc"
                                    <%= sort === 'name_desc' ? 'checked' : '' %>
                                    class="w-4 h-4 text-[var(--accent)] border-gray-300 focus:ring-rose-400"> <span
                                    class="text-sm text-gray-600 group-hover:text-gray-900 transition-colors">Name: Z-A</span>
                            </label>
                        </div>
                    </div>
                    <button type="submit"
                        class="w-full rounded-lg bg-gray-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-gray-800 transition-colors btn-press">Apply
                        Filters</button>
                </div>
                </form>
            </aside> <!-- Mobile Filter Button --> <button id="options-menu"
                class="md:hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-40 rounded-full bg-gray-900 text-white px-6 py-3 text-sm font-semibold shadow-lg hover:bg-gray-800 transition-colors btn-press">
                <i class="fa-solid fa-sliders fa-sm"></i> Filters </button> <!-- Products Grid -->
            <main class="flex-1 min-w-0">
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-2 sm:gap-3">
                    <% if(products && products.length) { %>
                        <% const catMap = {}; if (categories && categories.length) { categories.forEach(function(c) { catMap[c.title] = c._id; }); } %>
                        <% products.forEach((product)=> { var discPrice = product.discount ?
                            Math.round(product.productPrice - (product.productPrice * product.discount / 100)) :
                            product.productPrice; var matchedOffer = (offers && offers.length) ? offers.find(function(o)
                            { return o.brandName === product.brand && o.category.toString() === (catMap[product.category] || '').toString(); }) : null; var finalPrice = discPrice; var hasOffer
                            = matchedOffer && matchedOffer.discount > 0; if (hasOffer) { finalPrice =
                            Math.round(discPrice - (discPrice * matchedOffer.discount / 100)); } %> <div class="group product-card border border-[var(--card-border)] bg-white rounded-lg overflow-hidden transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-[var(--card-border-hover)] hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-2">
                                <a href="/user/viewProduct?productId=<%=product._id%>" class="block btn-press">
                                    <div class="relative overflow-hidden bg-gray-50 aspect-square">
                                        <img src="<%=product.images[0]%>" alt="<%=product.productName%>"
                                            class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-700 ease-out" />
                                        <% if(product.discount && product.discount > 0) { %>
                                            <div class="absolute top-1.5 left-1.5 z-10">
                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-[var(--badge-sale)] text-[var(--badge-sale-text)]">
                                                    -<%= product.discount %>% off
                                                </span>
                                            </div>
                                        <% } %>
                                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-300"></div>
                                    </div>
                                    <div class="p-2 space-y-1">
                                        <p class="text-[9px] text-[var(--text-brand)] uppercase tracking-widest font-medium truncate">
                                            <%= product.brand || 'BazaarBuzz' %>
                                        </p>
                                        <h3 class="text-[11px] font-medium text-[var(--text-primary)] line-clamp-2 min-h-[1.65rem] leading-tight">
                                            <%= product.productName %>
                                        </h3>
                                        <div class="flex items-center gap-1 flex-wrap min-h-[1rem]">
                                            <% if(product.limitedEdition) { %>
                                                <span class="inline-flex items-center px-1 py-0.5 rounded text-[8px] font-semibold bg-amber-600 text-white leading-none">Limited</span>
                                            <% } %>
                                            <% if(product.featured && !product.limitedEdition) { %>
                                                <span class="inline-flex items-center px-1 py-0.5 rounded text-[8px] font-semibold bg-[var(--accent)] text-white leading-none">Featured</span>
                                            <% } %>
                                            <% if(hasOffer) { %>
                                                <span class="inline-flex items-center px-1 py-0.5 rounded text-[8px] font-semibold bg-green-600 text-white leading-none"><%= matchedOffer.offerName %></span>
                                            <% } %>
                                            <% if(product.discount && product.discount > 0) { %>
                                                <span class="text-[8px] font-semibold text-[var(--badge-sale)] leading-none">-<%= product.discount %>% off</span>
                                            <% } %>
                                        </div>
                                        <div class="flex items-baseline gap-1">
                                            <% if(finalPrice !== product.productPrice) { %>
                                                <span class="text-xs font-bold text-[var(--text-primary)]">₹<%= finalPrice.toLocaleString('en-IN') %></span>
                                                <span class="text-[10px] text-[var(--text-muted)] line-through">₹<%= product.productPrice.toLocaleString('en-IN') %></span>
                                            <% } else { %>
                                                <span class="text-xs font-bold text-[var(--text-primary)]">₹<%= product.productPrice.toLocaleString('en-IN') %></span>
                                            <% } %>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div class="col-span-full flex flex-col items-center justify-center py-20"> <i class="fa-regular fa-circle-question text-5xl text-gray-300 mb-4"></i>
                                        <h3 class="text-lg font-semibold text-gray-500">No products found</h3>
                                        <p class="text-sm text-gray-400 mt-1">Try adjusting your search or filter
                                            criteria</p>
                                    </div>
                                    <% } %>
                </div>
            </main>
        </div>
    </div>
    <% blocks.scripts=` <script> document.querySelector('#options-menu')?.addEventListener('click', () => { const menu =
        document.querySelector('#dropdown-menu'); menu.classList.remove('hidden'); menu.classList.add('fixed',
        'inset-0', 'z-50', 'w-full', 'bg-white', 'p-6', 'overflow-y-auto');
        document.querySelector('#options-menu').classList.add('hidden'); const sticky = menu.querySelector('.sticky'); if (sticky) sticky.classList.remove('sticky'); }); document.addEventListener('click', function(e) {
        const menu = document.querySelector('#dropdown-menu'); if (menu?.classList.contains('fixed')) { const closeBtn =
        document.createElement('button'); closeBtn.className = 'absolute top-4 right-4 text-gray-400
        hover:text-gray-600';         closeBtn.innerHTML = '<i class="fa-solid fa-xmark text-lg"></i>'; closeBtn.onclick = function() { menu.classList.add('hidden'); menu.classList.remove('fixed', 'inset-0',
        'z-50', 'w-full', 'bg-white', 'p-6', 'overflow-y-auto');
        document.querySelector('#options-menu')?.classList.remove('hidden'); }; if
        (!menu.querySelector('.close-filter-btn')) { closeBtn.classList.add('close-filter-btn'); menu.prepend(closeBtn);
        } } }); </script>
        <script src="/javascript/user/homesearch.js"></script>
        <script src="/javascript/user/buttonSearch.js"></script>
        ` %>