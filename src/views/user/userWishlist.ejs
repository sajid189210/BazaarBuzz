<% blocks.head=` <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>` %>
    <div
        class="mx-auto max-w-[1400px] px-3 xs:px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-16">
        <nav class="hidden lg:flex items-center gap-2 text-sm text-gray-500 mb-8"> <a href="/"
                class="hover:text-[var(--accent)] transition-colors btn-press">Home</a> <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i> <span class="text-gray-800 font-medium">Wishlist</span> </nav>
        <h1 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-8">Wishlist</h1>
        <% if(wishlist && wishlist.items && wishlist.items.length> 0) { %> <div
                class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 md:gap-6">
                <% wishlist.items.forEach(item=> { const product = item.product; %> <div
                    class="bg-white rounded-xl shadow-sm overflow-hidden group"
                    data-product-id="<%= product._id %>">
                    <!-- Image -->
                    <a href="/user/viewProduct?productId=<%= product._id %>"
                       class="block overflow-hidden aspect-[3/4] bg-gray-50 btn-press">
                        <img src="<%= product.images[0] %>" alt="<%= product.productName %>"
                             class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-out" />
                    </a>
                    <!-- Details -->
                    <div class="p-3 space-y-2">
                        <a href="/user/viewProduct?productId=<%= product._id %>" class="block">
                            <p class="text-[11px] xs:text-xs text-gray-400 uppercase tracking-widest">
                                <%= product.brand || 'BazaarBuzz' %>
                            </p>
                            <h3 class="text-sm font-medium text-gray-800 truncate">
                                <%= product.productName %>
                            </h3>
                        </a>
                        <div class="flex items-center gap-2">
                            <% if(product.discount) { %>
                            <span class="text-sm font-semibold text-gray-900">₹<%= Math.round(product.productPrice - (product.productPrice * product.discount / 100)).toLocaleString() %></span>
                            <span class="text-xs text-gray-400 line-through">₹<%= product.productPrice.toLocaleString() %></span>
                            <span class="text-[11px] font-medium text-green-600"><%= product.discount %>% off</span>
                            <% } else { %>
                            <span class="text-sm font-semibold text-gray-900">₹<%= product.productPrice.toLocaleString() %></span>
                            <% } %>
                        </div>

                        <button onclick="event.stopPropagation(); toggleWishList('<%= product._id %>', this)"
                            class="w-full text-center text-sm font-medium rounded-lg py-2.5 border border-gray-200 text-[var(--accent)] hover:bg-gray-50 transition-colors btn-press filled">
                            <i class="fa-solid fa-heart mr-1.5"></i> Remove from Wishlist
                        </button>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-20"> <i class="fa-regular fa-heart text-5xl text-gray-300 mb-4"></i>
                    <h3 class="text-lg font-semibold text-gray-500">Your wishlist is empty</h3> <a
                        href="/user/productList"
                        class="mt-4 text-sm font-medium text-[var(--accent)] hover:text-[var(--accent)] transition-colors btn-press">Discover
                        Products</a>
                </div>
                <% } %>
    </div>
    <% blocks.scripts=`
<script>
var Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 2000 });

async function toggleWishList(productId, btn) {
    if (!productId) return;
    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) { btn.style.transform = 'scale(0.9)'; setTimeout(function() { btn.style.transform = ''; }, 100); }
    try {
        var res = await fetch('/user/wishlist', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ productId: productId }) });
        var data = await res.json();
        if (!data.session) { await Swal.fire({ title: 'Sign In!', text: data.message, icon: 'info' }); window.location.href = data.redirectUrl; return; }
        if (!data.success) { await Swal.fire({ title: 'Failed', text: data.message, icon: 'warning' }); if (data.redirectUrl) window.location.href = data.redirectUrl; return; }
        var isAdd = data.action === 'added';
        btn.classList.toggle('filled', isAdd);
        btn.setAttribute('aria-label', isAdd ? 'Remove from wishlist' : 'Add to wishlist');
        var icon = btn.querySelector('i');
        if (icon) {
            icon.classList.remove('fa-regular', 'fa-solid');
            icon.classList.add(isAdd ? 'fa-solid' : 'fa-regular');
            if (!prefersReducedMotion && isAdd) {
                icon.style.transform = 'scale(1.3)';
                setTimeout(function() { icon.style.transition = 'transform 400ms cubic-bezier(0.16, 1, 0.3, 1)'; icon.style.transform = 'scale(1)'; }, 50);
            }
        }
        Toast.fire({ icon: 'success', title: data.message });
        if (!isAdd) {
            var card = btn.closest('[data-product-id]');
            if (card) { card.style.transition = 'opacity 0.3s, transform 0.3s'; card.style.opacity = '0'; card.style.transform = 'scale(0.9)'; setTimeout(function() { card.remove(); }, 300); }
        }
    } catch (e) { console.log(e); Swal.fire({ icon: 'error', title: 'Something went wrong.' }); }
}
</script>` %>