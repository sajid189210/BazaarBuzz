<% blocks.head=` <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/javascript/ntc.js"></script>` %>

<div class="mx-auto max-w-[1400px] px-3 xs:px-4 sm:px-6 lg:px-8 pt-3 xs:pt-4 sm:pt-6 pb-16">
    <nav class="hidden lg:flex items-center gap-2 text-sm text-gray-500 mb-6">
        <a href="/" class="hover:text-[var(--accent)] transition-colors btn-press">Home</a>
        <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>
        <span class="text-gray-800 font-medium">Cart</span>
    </nav>

    <h1 class="text-xl xs:text-2xl font-bold text-gray-900 mb-4 xs:mb-6">Shopping Cart</h1>

    <div class="lg:flex lg:gap-10">
        <div class="flex-1 min-w-0 max-h-none lg:max-h-[calc(100dvh-280px)] overflow-y-auto">
            <% if(cart && cart.items && cart.items.length > 0) { %>
                <div class="space-y-3">
                    <% cart.items.forEach((item, index) => { %>
                        <% const prod = item.product || {}; %>
                        <% const offer = item.offer || null; %>
                        <% const snapshotPrice = item.productPrice ?? prod.productPrice; %>
                        <% const snapshotDiscount = item.productDiscount ?? prod.discount; %>
                        <% const finalUnitPrice = item.discountedPrice || prod.productPrice; %>
                        <% const subtotal = finalUnitPrice * item.quantity; %>
                        <% const totalSavings = snapshotPrice !== finalUnitPrice ? ((snapshotPrice - finalUnitPrice) * item.quantity) : 0; %>
                        <% const discountPercent = snapshotPrice !== finalUnitPrice ? Math.round((1 - finalUnitPrice / snapshotPrice) * 100) : 0; %>

                        <div class="border border-gray-200 rounded-xl bg-white hover:shadow-sm transition-shadow duration-150" data-item-id="<%= item._id %>">
                            <div class="grid grid-cols-[100px_1fr_auto] gap-3.5 sm:gap-4 p-4 sm:px-5">
                                <a href="/user/viewProduct?productId=<%= prod._id %>" class="w-[100px] sm:w-[110px] h-[120px] sm:h-[130px] rounded-lg overflow-hidden bg-gray-50 shrink-0">
                                    <img src="<%= prod.images?.[0] || '/images/placeholder.jpg' %>" alt="<%= prod.productName %>" class="w-full h-full object-cover" loading="lazy" />
                                </a>

                                <div class="min-w-0">
                                    <p class="text-[11px] tracking-widest text-gray-400 uppercase"><%= prod.brand || 'BazaarBuzz' %></p>
                                    <a href="/user/viewProduct?productId=<%= prod._id %>" class="text-sm font-medium text-gray-900 hover:text-[var(--accent)] transition-colors leading-tight block"><%= prod.productName %></a>

                                    <div class="text-xs text-gray-500 mt-1 flex flex-wrap items-center gap-x-1.5">
                                        <span>Size: <%= item.selectedSize || 'N/A' %></span>
                                        <span class="text-gray-300">·</span>
                                        <span class="cart-color inline-flex items-center gap-1 whitespace-nowrap" data-color="<%= item.selectedColor || '' %>">
                                            <span class="cart-color-dot w-3 h-3 rounded-full border border-gray-300 shrink-0"></span>
                                            <span class="cart-color-name"><%= item.selectedColor || 'N/A' %></span>
                                        </span>
                                    </div>

                                    <p class="text-green-600 text-xs font-medium mt-1"><i class="fa-solid fa-check-circle fa-xs"></i> In Stock</p>

                                    <div class="flex items-center gap-3 mt-3">
                                        <div class="flex items-center border border-gray-300 rounded-md overflow-hidden">
                                            <button onclick="updateQuantity('<%= item._id %>', -1)" class="w-[30px] h-[30px] flex items-center justify-center border-none bg-gray-50 text-gray-700 text-base cursor-pointer hover:bg-gray-100 transition-colors" <%= item.quantity <= 1 ? 'disabled style="opacity:0.4;cursor:not-allowed"' : '' %> aria-label="Decrease quantity">&minus;</button>
                                            <span class="w-9 text-center text-sm font-medium text-gray-900 select-none quantity-display"><%= item.quantity %></span>
                                            <button onclick="updateQuantity('<%= item._id %>', 1)" class="w-[30px] h-[30px] flex items-center justify-center border-none bg-gray-50 text-gray-700 text-base cursor-pointer hover:bg-gray-100 transition-colors" <%= item.quantity >= 5 ? 'disabled style="opacity:0.4;cursor:not-allowed"' : '' %> aria-label="Increase quantity">+</button>
                                        </div>
                                        <button onclick="removeItem('<%= item._id %>')" class="inline-flex items-center gap-1 text-xs font-medium bg-transparent border-none cursor-pointer text-gray-500 hover:bg-red-50 hover:text-red-500 px-1.5 py-1 rounded-md transition-colors" aria-label="Remove item">
                                            <i class="fa-regular fa-trash-can text-sm"></i> Remove
                                        </button>
                                    </div>
                                </div>

                                <div class="text-right flex flex-col items-end gap-px min-w-[90px]">
                                    <span class="text-base font-bold text-gray-900 leading-tight">₹<%= finalUnitPrice.toLocaleString('en-IN') %></span>
                                    <% if(snapshotPrice !== finalUnitPrice) { %>
                                        <span class="text-xs text-gray-400 line-through">₹<%= snapshotPrice.toLocaleString('en-IN') %></span>
                                    <% } %>
                                    <hr class="w-full border-gray-200 my-1.5">
                                    <span class="text-xs text-gray-500">₹<%= finalUnitPrice.toLocaleString('en-IN') %> × <%= item.quantity %></span>
                                    <span class="text-sm font-semibold text-gray-900">₹<%= subtotal.toLocaleString('en-IN') %></span>
                                </div>
                            </div>

                            <% if(snapshotPrice !== finalUnitPrice) { %>
                                <div class="border-t border-gray-100 px-4 sm:px-5 py-2.5">
                                    <p class="text-[11px] font-semibold text-gray-700 uppercase tracking-wide mb-0.5">Discount Applied</p>
                                    <div class="flex flex-wrap gap-x-3.5 gap-y-0.5 text-xs text-green-600">
                                        <% if(snapshotDiscount > 0) { %>
                                            <span><%= snapshotDiscount %>% product discount</span>
                                        <% } %>
                                        <% if(offer && offer.discount > 0) { %>
                                            <% if(snapshotDiscount > 0) { %><span class="text-gray-300">|</span><% } %>
                                           <span><%= offer.discount %>% brand offer</span>
                                        <% } %>
                                    </div>
                                    <p class="text-xs text-gray-500 mt-0.5">You save ₹<%= totalSavings.toLocaleString('en-IN') %> on this item</p>
                                </div>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-20">
                    <i class="fa-solid fa-cart-shopping text-5xl text-gray-300 mb-4"></i>
                    <h3 class="text-lg font-semibold text-gray-500">Your cart is empty</h3>
                    <a href="/user/getProductList/all" class="mt-4 text-sm font-medium text-[var(--accent)] hover:text-[var(--accent)] transition-colors btn-press">Continue Shopping</a>
                </div>
            <% } %>
        </div>

        <% if(cart && cart.items && cart.items.length > 0) { %>
            <div class="lg:w-96 mt-8 lg:mt-0">
                <div class="sticky top-24 rounded-xl border border-gray-200 bg-white p-5 xs:p-6">
                    <h2 class="text-base font-semibold text-gray-900 mb-4">Order Summary</h2>
                    <div class="space-y-3 text-sm">
                        <div class="flex justify-between text-gray-600">
                            <span>Subtotal</span>
                            <span id="subtotalAmount">₹<%= (subTotal || 0).toLocaleString('en-IN') %></span>
                        </div>
                        <% if(totalDiscount && totalDiscount > 0) { %>
                            <% const showTooltip = (productDiscTotal || 0) > 0 || (offerDiscTotal || 0) > 0; %>
                            <div class="flex justify-between text-gray-600 relative group">
                                <span class="<%- showTooltip ? 'cursor-help border-b border-dotted border-green-400' : '' %>">Discount</span>
                                <span class="text-green-600 font-medium">&minus; ₹<%= totalDiscount.toLocaleString('en-IN') %></span>
                                <% if(showTooltip) { %>
                                    <div class="absolute bottom-full left-0 mb-2 hidden group-hover:block bg-gray-900 text-white text-xs rounded-lg px-3 py-2 whitespace-nowrap z-10 shadow-lg">
                                        <div class="space-y-1">
                                            <% if((productDiscTotal || 0) > 0) { %>
                                                <div class="flex justify-between gap-4"><span>Product discount</span><span class="text-green-300">&minus; ₹<%= (productDiscTotal || 0).toLocaleString('en-IN') %></span></div>
                                            <% } %>
                                            <% if((offerDiscTotal || 0) > 0) { %>
                                                <div class="flex justify-between gap-4"><span>Brand offer</span><span class="text-green-300">&minus; ₹<%= (offerDiscTotal || 0).toLocaleString('en-IN') %></span></div>
                                            <% } %>
                                        </div>
                                        <div class="absolute top-full left-4 w-0 h-0 border-4 border-transparent border-t-gray-900"></div>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>
                        <div class="flex justify-between text-gray-600">
                            <span>Shipping</span>
                            <span class="text-green-600 font-medium">Free</span>
                        </div>
                        <div class="flex justify-between text-gray-600">
                            <span>Tax (5%)</span>
                            <span>₹<%= (taxAmount || 0).toLocaleString('en-IN') %></span>
                        </div>
                        <hr class="border-gray-100">
                        <div class="flex justify-between text-base font-semibold text-gray-900">
                            <span>Total</span>
                            <span id="totalAmount">₹<%= (total || subTotal || 0).toLocaleString('en-IN') %></span>
                        </div>
                    </div>
                    <a href="/user/checkout" class="mt-6 block w-full rounded-lg bg-gray-900 px-4 py-3 text-sm font-semibold text-white text-center hover:bg-gray-800 transition-colors btn-press">Proceed to Checkout</a>
                    <a href="/user/getProductList/all" class="mt-3 block text-center text-sm text-[var(--accent)] hover:text-[var(--accent)] transition-colors btn-press">Continue Shopping</a>
                </div>
            </div>
        <% } %>
    </div>
</div>

<% blocks.scripts=` <script src="/javascript/user/userCart.js"></script> `%>
